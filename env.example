# API base URL (required for production)
NEXT_PUBLIC_API_URL=http://localhost:4001

# App (optional)
NEXT_PUBLIC_APP_NAME=DragBizz Store
NEXT_PUBLIC_APP_VERSION=1.0.0

# Auth token keys (optional - defaults used if not set)
NEXT_PUBLIC_AUTH_TOKEN_KEY=db_auth_token
NEXT_PUBLIC_REFRESH_TOKEN_KEY=db_refresh_token
NEXT_PUBLIC_RETAILER_TOKEN_KEY=db_retailer_token

# API behaviour (optional)
NEXT_PUBLIC_API_TIMEOUT=10000
NEXT_PUBLIC_API_VERSION=v1
NEXT_PUBLIC_API_RETRY_ATTEMPTS=3
NEXT_PUBLIC_API_RETRY_DELAY=1000
NEXT_PUBLIC_API_CACHE_DURATION=300000

# External (optional)
NEXT_PUBLIC_GOOGLE_MAPS_API=
NEXT_PUBLIC_STRIPE_API=
NEXT_PUBLIC_PAYPAL_API=
NEXT_PUBLIC_TWILIO_API=
