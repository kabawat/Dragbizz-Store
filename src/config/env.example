# Environment Configuration Example
# Copy this to .env.local and update with your actual values
# 
# Usage in code:
# ENV_CONFIG.API.URL, ENV_CONFIG.APP.NAME, ENV_CONFIG.AUTH.TOKEN_KEY, etc.

# API Configuration (ENV_CONFIG.API.*)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_API_TIMEOUT=10000

# App Configuration (ENV_CONFIG.APP.*)
NEXT_PUBLIC_APP_NAME=DragBizz Store
NEXT_PUBLIC_APP_VERSION=1.0.0

# Authentication Keys (ENV_CONFIG.AUTH.*)
NEXT_PUBLIC_AUTH_TOKEN_KEY=authToken
NEXT_PUBLIC_REFRESH_TOKEN_KEY=refreshToken
